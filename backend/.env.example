# ConstructMind AI - Environment Variables
# Created by Moawia Husnain | Civil Engineer | UET Taxila | +923266915744

# Google Gemini API Key (for BOQ analysis, activity generation, reports)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for AI copilot chat - uses Llama 4 Scout)
GROQ_API_KEY=your_groq_api_key_here

# Database URL (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./constructmind.db

# CORS Origins (comma-separated, use * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk Secret Key (for authentication)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# App Settings
APP_ENV=development
DEBUG=true
